# MediaHub v22.0 example. Do not publish real API keys.
MEDIA_ROOT=/mnt/media
MOVIES_ROOT=/mnt/media/movies
TV_ROOT=/mnt/media/tv
ANIME_ROOT=/mnt/media/anime
INBOX_ROOT=/mnt/media/inbox
MEDIAHUB_CACHE_DB=/var/lib/mediahub/cache.db

RADARR_URL=http://127.0.0.1:7878
SONARR_URL=http://127.0.0.1:8989
PROWLARR_URL=http://127.0.0.1:9696
QBIT_URL=http://127.0.0.1:8080

# Local ARR API keys are normally detected automatically after MediaHub restart.
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=

# Can also be entered in MediaHub -> Установка -> Подключения.
QBIT_USER=
QBIT_PASS=
TMDB_API_KEY=
KINOPOISK_API_KEY=
KINOPOISK_API_URL=https://kinopoiskapiunofficial.tech
# Optional proxy only for public catalogs (TMDB/AniList/TVmaze/AniLiberty).
MEDIAHUB_OUTBOUND_PROXY=
ANILIBERTY_DISCOVERY_URL=https://aniliberty.top/
TVMAZE_ENABLED=1

# Setup Center can change the Linux system only from LAN/private addresses by default.
MEDIAHUB_ALLOW_PUBLIC_SETUP=0

# Необязательный отдельный канал для импорта страниц через Windows-ПК.
# MEDIAHUB_PAGE_PROXY=socks5h://127.0.0.1:18090
